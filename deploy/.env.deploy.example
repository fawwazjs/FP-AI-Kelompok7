# Copy this file to deploy/.env.deploy before running Docker Compose.
# Keep deploy/.env.deploy out of git.

# Local test default:
LOKALATOR_SITE_ADDRESS=:8080
ALLOWED_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# Production example:
# LOKALATOR_SITE_ADDRESS=lokalator.com
# ALLOWED_ORIGINS=https://lokalator.com
# ALLOWED_HOSTS=lokalator.com,www.lokalator.com

NEXT_PUBLIC_API_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_USE_RAG=0

DATABASE_URL=sqlite:////data/lokalator.db
RAG_PERSIST_DIR=/data/chroma_db
UPLOAD_DIR=/app/temp_uploads
OUTPUT_DIR=/app/temp_outputs

MAX_TEXT_CHARS=2000
MAX_UPLOAD_BYTES=5242880
MAX_DOCX_UNCOMPRESSED_BYTES=31457280
OUTPUT_TTL_SECONDS=3600

# Default avoids unnecessary CUDA packages when installing sentence-transformers.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
