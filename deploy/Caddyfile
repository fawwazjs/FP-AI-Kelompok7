{$LOKALATOR_SITE_ADDRESS::8080} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
